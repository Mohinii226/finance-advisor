# One-off and nightly jobs: demo-data bootstrap, overspend detector, health scores, forecasts, categoriser.
# Uses the full requirements (the API / app images deliberately leave out the ML libraries).
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY core ./core
COPY llm ./llm
COPY ml ./ml
COPY data_gen ./data_gen
COPY sql ./sql
COPY deploy/bootstrap.py ./deploy/bootstrap.py
RUN useradd --system --create-home --uid 10001 appuser && mkdir -p /app/data && chown -R appuser /app/data
USER appuser
