# Caddy obtains and renews HTTPS certificates automatically (needs ports 80 and 443 open and the DNS records in place).
{
	email {$ACME_EMAIL}
}

(secure) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$APP_DOMAIN} {
	import secure
	reverse_proxy app:8501        # Streamlit's websocket is proxied automatically
}

{$API_DOMAIN} {
	import secure
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8000
}
