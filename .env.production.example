# Copy to .env.production on the server and fill in EVERY value. Never commit it. chmod 600 .env.production
# Use only letters and digits in POSTGRES_PASSWORD (it is placed inside a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=

# Password for the limited database role the API and app use (row-level security, sql/rls.sql). Letters and digits only.
APP_DB_PASSWORD=
# The same password inside the URL (the role is created by sql/rls.sql):
APP_DATABASE_URL=postgresql+psycopg2://finsight_app:PUT_APP_DB_PASSWORD_HERE@db:5432/finance_advisor

# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Two DNS A records pointing at this server's public IP
APP_DOMAIN=finsight.example.com
API_DOMAIN=api.finsight.example.com
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices go here

# Sign-up and demo
ALLOW_SIGNUP=true
REQUIRE_EMAIL_VERIFICATION=true
DEMO_CUSTOMER_ID=C0001                # after the demo-data bootstrap; leave empty to disable the demo login
SESSION_DAYS=7
CHAT_PER_HOUR=60
CHAT_PER_HOUR_DEMO=20

# Email (required: verification and password-reset links are sent from here)
MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FinSight <no-reply@finsight.example.com>"
SMTP_SECURITY=starttls

# Optional LLM chat. LEAVE EMPTY to keep every user's data inside your own server (offline rule-based chat).
# If you set it, questions and the figures computed for them are sent to Anthropic: disclose that in docs/privacy_notice_template.md.
ANTHROPIC_API_KEY=
ADVISOR_MODEL=
