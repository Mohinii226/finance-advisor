# Copy to .env (VS Code launch configs and tasks read it). Never commit .env.
DATABASE_URL=postgresql+psycopg2://finance:finance@localhost:5432/finance_advisor

# Optional: require this key in the X-API-Key header (demo-level auth). Leave unset for open local use.
# ADVISOR_API_KEY=change-me

# Optional: real LLM for /chat. If unset, the offline rule-based demo chat is used.
# ANTHROPIC_API_KEY=sk-ant-...
# ADVISOR_MODEL=claude-haiku-4-5-20251001

# ---- Login (core/auth.py). The API refuses to start without JWT_SECRET.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_TTL_MINUTES=60
# ALLOW_SIGNUP=true
# DEMO_CUSTOMER_ID=C0001          # enables the password-less "Try the demo" button / POST /auth/demo
# REQUIRE_EMAIL_VERIFICATION=true # set false for quick local tests
# SESSION_DAYS=7
# APP_BASE_URL=http://localhost:8501   # used in the links inside verification / reset emails
# COOKIE_SECURE=false             # keep false on plain http://localhost; true behind HTTPS (the default)

# ---- Email. "console" prints the links to the log (development only, refused when APP_ENV=production).
MAIL_BACKEND=console
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="FinSight <no-reply@yourdomain.com>"
# SMTP_SECURITY=starttls          # starttls | ssl | none
